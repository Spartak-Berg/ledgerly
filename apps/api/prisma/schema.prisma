generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String          @id @default(uuid()) @db.Uuid
  email             String          @unique
  passwordHash      String
  fullName          String
  selectedCompanyId String?         @db.Uuid
  emailVerifiedAt   DateTime?
  memberships       CompanyMember[]
  sessions          Session[]
  recordedPayments  Payment[]       @relation("PaymentRecordedBy")
  reversedPayments  Payment[]       @relation("PaymentReversedBy")
  createdExpenses   Expense[]       @relation("ExpenseCreatedBy")
  reviewedExpenses  Expense[]       @relation("ExpenseReviewedBy")
  selectedCompany   Company?        @relation("SelectedCompany", fields: [selectedCompanyId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("users")
}

model Company {
  id                 String            @id @default(uuid()) @db.Uuid
  name               String
  slug               String            @unique
  defaultCurrency    String            @default("NOK") @db.VarChar(3)
  organisationNumber String?
  email              String?
  phone              String?
  website            String?
  addressLine1       String?
  addressLine2       String?
  postalCode         String?
  city               String?
  countryCode        String            @default("NO") @db.VarChar(2)
  vatRegistered      Boolean           @default(false)
  vatNumber          String?
  bankAccount        String?
  iban               String?
  bic                String?
  memberships        CompanyMember[]
  settings           CompanySettings?
  selectedBy         User[]            @relation("SelectedCompany")
  customers          Customer[]
  products           Product[]
  invoices           Invoice[]
  payments           Payment[]
  suppliers          Supplier[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([name])
  @@map("companies")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @db.Uuid
  name            String
  description     String?
  sku             String?
  type            ProductType   @default(SERVICE)
  unit            String        @default("hour")
  defaultQuantity Decimal       @default(1) @db.Decimal(12, 4)
  unitPriceMinor  Int
  vatRate         Decimal       @default(25) @db.Decimal(5, 2)
  currency        String        @default("NOK") @db.VarChar(3)
  category        String?
  active          Boolean       @default(true)
  archivedAt      DateTime?
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoiceItems    InvoiceItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([companyId, sku])
  @@index([companyId, active, name])
  @@map("products")
}

model CompanyMember {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  companyId String      @db.Uuid
  role      CompanyRole @default(EMPLOYEE)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, companyId])
  @@index([companyId, role])
  @@map("company_members")
}

model CompanySettings {
  companyId               String   @id @db.Uuid
  defaultPaymentDays      Int      @default(14)
  defaultVatRate          Decimal  @default(25) @db.Decimal(5, 2)
  financialYearStartMonth Int      @default(1)
  invoicePrefix           String   @default("INV") @db.VarChar(10)
  invoiceNumberPadding    Int      @default(4)
  nextInvoiceNumber       Int      @default(1)
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("company_settings")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  userAgent  String?   @db.VarChar(500)
  ipAddress  String?   @db.VarChar(64)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Customer {
  id                  String         @id @default(uuid()) @db.Uuid
  companyId           String         @db.Uuid
  companyName         String
  type                CustomerType   @default(COMPANY)
  organisationNumber  String?
  contactName         String?
  email               String?
  phone               String?
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingPostalCode   String?
  billingCity         String?
  postalAddressLine1  String?
  postalAddressLine2  String?
  postalPostalCode    String?
  postalCity          String?
  countryCode         String         @default("NO") @db.VarChar(2)
  vatNumber           String?
  defaultCurrency     String         @default("NOK") @db.VarChar(3)
  defaultPaymentDays  Int            @default(14)
  notes               String?
  status              CustomerStatus @default(ACTIVE)
  archivedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoices            Invoice[]

  @@index([companyId, companyName])
  @@index([companyName])
  @@map("customers")
}

model Invoice {
  id                     String        @id @default(uuid()) @db.Uuid
  companyId              String        @db.Uuid
  customerId             String        @db.Uuid
  status                 InvoiceStatus @default(DRAFT)
  number                 String?
  issueDate              DateTime      @db.Date
  dueDate                DateTime      @db.Date
  currency               String        @default("NOK") @db.VarChar(3)
  reference              String?
  purchaseOrderReference String?
  notes                  String?
  paymentTerms           String?
  customerNameSnapshot   String
  companyNameSnapshot    String
  customerSnapshot       Json          @default("{}")
  companySnapshot        Json          @default("{}")
  subtotalMinor          Int           @default(0)
  vatMinor               Int           @default(0)
  totalMinor             Int           @default(0)
  version                Int           @default(1)
  archivedAt             DateTime?
  issuedAt               DateTime?
  sentAt                 DateTime?
  voidedAt               DateTime?
  voidReason             String?
  company                Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer               Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items                  InvoiceItem[]
  payments               Payment[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@unique([companyId, number])
  @@index([companyId, status, issueDate])
  @@index([companyId, customerId])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @db.Uuid
  productId      String?  @db.Uuid
  description    String
  quantity       Decimal  @db.Decimal(12, 4)
  unit           String
  unitPriceMinor Int
  vatRate        Decimal  @db.Decimal(5, 2)
  subtotalMinor  Int
  vatMinor       Int
  totalMinor     Int
  position       Int
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([invoiceId, position])
  @@index([productId])
  @@map("invoice_items")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @db.Uuid
  invoiceId      String        @db.Uuid
  amountMinor    Int
  paymentDate    DateTime      @db.Date
  method         PaymentMethod
  reference      String?
  note           String?
  recordedById   String        @db.Uuid
  reversedAt     DateTime?
  reversedById   String?       @db.Uuid
  reversalReason String?
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy     User          @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  reversedBy     User?         @relation("PaymentReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())

  @@index([companyId, paymentDate])
  @@index([invoiceId, reversedAt])
  @@map("payments")
}

model Supplier {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @db.Uuid
  name               String
  organisationNumber String?
  email              String?
  phone              String?
  addressLine1       String?
  postalCode         String?
  city               String?
  countryCode        String    @default("NO") @db.VarChar(2)
  notes              String?
  active             Boolean   @default(true)
  archivedAt         DateTime?
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  expenses           Expense[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([companyId, active, name])
  @@map("suppliers")
}

model ExpenseCategory {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  name      String
  systemKey String?
  vatRate   Decimal   @default(25) @db.Decimal(5, 2)
  active    Boolean   @default(true)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([companyId, name])
  @@unique([companyId, systemKey])
  @@index([companyId, active, name])
  @@map("expense_categories")
}

model Expense {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        String          @db.Uuid
  supplierId       String?         @db.Uuid
  categoryId       String          @db.Uuid
  merchantSnapshot String
  description      String?
  expenseDate      DateTime        @db.Date
  currency         String          @default("NOK") @db.VarChar(3)
  netMinor         Int
  vatMinor         Int
  totalMinor       Int
  paymentMethod    PaymentMethod
  status           ExpenseStatus   @default(DRAFT)
  notes            String?
  archivedAt       DateTime?
  reviewedAt       DateTime?
  createdById      String          @db.Uuid
  reviewedById     String?         @db.Uuid
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier         Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  category         ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy        User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy       User?           @relation("ExpenseReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([companyId, expenseDate])
  @@index([companyId, status, archivedAt])
  @@index([supplierId])
  @@index([categoryId])
  @@map("expenses")
}

enum CustomerStatus {
  ACTIVE
  LEAD
  ARCHIVED
}

enum CustomerType {
  COMPANY
  INDIVIDUAL
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  OTHER
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum CompanyRole {
  OWNER
  ADMIN
  ACCOUNTANT
  EMPLOYEE
}
