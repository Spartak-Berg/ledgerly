generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String          @id @default(uuid()) @db.Uuid
  email             String          @unique
  passwordHash      String
  fullName          String
  selectedCompanyId String?         @db.Uuid
  emailVerifiedAt   DateTime?
  memberships       CompanyMember[]
  sessions          Session[]
  selectedCompany   Company?        @relation("SelectedCompany", fields: [selectedCompanyId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("users")
}

model Company {
  id                 String           @id @default(uuid()) @db.Uuid
  name               String
  slug               String           @unique
  defaultCurrency    String           @default("NOK") @db.VarChar(3)
  organisationNumber String?
  email              String?
  phone              String?
  website            String?
  addressLine1       String?
  addressLine2       String?
  postalCode         String?
  city               String?
  countryCode        String           @default("NO") @db.VarChar(2)
  vatRegistered      Boolean          @default(false)
  vatNumber          String?
  bankAccount        String?
  iban               String?
  bic                String?
  memberships        CompanyMember[]
  settings           CompanySettings?
  selectedBy         User[]           @relation("SelectedCompany")
  customers          Customer[]
  products           Product[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([name])
  @@map("companies")
}

model Product {
  id              String      @id @default(uuid()) @db.Uuid
  companyId       String      @db.Uuid
  name            String
  description     String?
  sku             String?
  type            ProductType @default(SERVICE)
  unit            String      @default("hour")
  defaultQuantity Decimal     @default(1) @db.Decimal(12, 4)
  unitPriceMinor  Int
  vatRate         Decimal     @default(25) @db.Decimal(5, 2)
  currency        String      @default("NOK") @db.VarChar(3)
  category        String?
  active          Boolean     @default(true)
  archivedAt      DateTime?
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([companyId, sku])
  @@index([companyId, active, name])
  @@map("products")
}

model CompanyMember {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  companyId String      @db.Uuid
  role      CompanyRole @default(EMPLOYEE)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, companyId])
  @@index([companyId, role])
  @@map("company_members")
}

model CompanySettings {
  companyId               String   @id @db.Uuid
  defaultPaymentDays      Int      @default(14)
  defaultVatRate          Decimal  @default(25) @db.Decimal(5, 2)
  financialYearStartMonth Int      @default(1)
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("company_settings")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  userAgent  String?   @db.VarChar(500)
  ipAddress  String?   @db.VarChar(64)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Customer {
  id                  String         @id @default(uuid()) @db.Uuid
  companyId           String         @db.Uuid
  companyName         String
  type                CustomerType   @default(COMPANY)
  organisationNumber  String?
  contactName         String?
  email               String?
  phone               String?
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingPostalCode   String?
  billingCity         String?
  postalAddressLine1  String?
  postalAddressLine2  String?
  postalPostalCode    String?
  postalCity          String?
  countryCode         String         @default("NO") @db.VarChar(2)
  vatNumber           String?
  defaultCurrency     String         @default("NOK") @db.VarChar(3)
  defaultPaymentDays  Int            @default(14)
  notes               String?
  status              CustomerStatus @default(ACTIVE)
  archivedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, companyName])
  @@index([companyName])
  @@map("customers")
}

enum CustomerStatus {
  ACTIVE
  LEAD
  ARCHIVED
}

enum CustomerType {
  COMPANY
  INDIVIDUAL
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum CompanyRole {
  OWNER
  ADMIN
  ACCOUNTANT
  EMPLOYEE
}
