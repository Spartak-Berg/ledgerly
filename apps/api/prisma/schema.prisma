generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id          String         @id @default(uuid()) @db.Uuid
  companyName String
  contactName String?
  email       String?
  phone       String?
  status      CustomerStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([companyName])
  @@map("customers")
}

enum CustomerStatus {
  ACTIVE
  LEAD
  ARCHIVED
}
