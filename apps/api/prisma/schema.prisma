generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  passwordHash String
  fullName     String
  emailVerifiedAt DateTime?
  memberships CompanyMember[]
  sessions     Session[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("users")
}

model Company {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  slug            String           @unique
  defaultCurrency String           @default("NOK") @db.VarChar(3)
  memberships     CompanyMember[]
  settings        CompanySettings?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([name])
  @@map("companies")
}

model CompanyMember {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  companyId String     @db.Uuid
  role      CompanyRole @default(EMPLOYEE)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, companyId])
  @@index([companyId, role])
  @@map("company_members")
}

model CompanySettings {
  companyId          String  @id @db.Uuid
  defaultPaymentDays Int     @default(14)
  defaultVatRate     Decimal @default(25) @db.Decimal(5, 2)
  company            Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("company_settings")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  userAgent  String?   @db.VarChar(500)
  ipAddress  String?   @db.VarChar(64)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Customer {
  id          String         @id @default(uuid()) @db.Uuid
  companyName String
  contactName String?
  email       String?
  phone       String?
  status      CustomerStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([companyName])
  @@map("customers")
}

enum CustomerStatus {
  ACTIVE
  LEAD
  ARCHIVED
}

enum CompanyRole {
  OWNER
  ADMIN
  ACCOUNTANT
  EMPLOYEE
}
